type Jar {
	id: ID!
	name: String!
	description: String!
	balance: String!
	goal: String
	inUse: Boolean!
	transactions(query: TransactionSearch = { filter: {} }): TransactionPage!
}

input UpdateJar {
	name: String!
	description: String!
	goal: String
}

input JarBalanceQuery {
	jarIds: [ID!]!
}

type JarBalanceSnapshot {
	date: String!
	balance: String!
}

type JarBalanceHistory {
	jarId: ID!
	snapshots: [JarBalanceSnapshot!]!
}

extend type Query {
	getJars: [Jar!]!
	getJar(id: ID!): Jar!

	queryJarBalanceHistory(req: JarBalanceQuery!): [JarBalanceHistory!]!
}

extend type Mutation {
	createJar(req: UpdateJar!): Jar!
	updateJar(id: ID!, req: UpdateJar!): Jar!
	deleteJar(id: ID!): Boolean!
}
