type Jar {
	id: ID!
	name: String!
	description: String!
	balance: String!
	goal: String
	inUse: Boolean!
	transactions(query: TransactionSearch = { filter: {} }): TransactionPage!
}

input UpdateJar {
	name: String!
	description: String!
	goal: String
}

extend type Query {
	getJars: [Jar!]!
	getJar(id: ID!): Jar!
}

extend type Mutation {
	createJar(req: UpdateJar!): Jar!
	updateJar(id: ID!, req: UpdateJar!): Jar!
	deleteJar(id: ID!): Boolean!
}
