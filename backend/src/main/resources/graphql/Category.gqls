type Category {
  id: ID!
  name: String!
  description: String!
  inUse: Boolean!
}

input UpdateCategory {
  name: String!
  description: String!
}

extend type Query {
  getCategories: [Category!]!
  getCategory(id: ID!): Category!
}

extend type Mutation {
  createCategory(req: UpdateCategory!): Category!
  updateCategory(id: ID!, req: UpdateCategory!): Category!
  deleteCategory(id: ID!): Boolean!
}
