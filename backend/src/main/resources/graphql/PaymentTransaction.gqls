enum PaymentTransactionDirection {
	INCOMING,
	OUTGOING
}

type PaymentTransaction implements Transaction {
	id: ID!
	date: String!
	amount: String!
	counterparty: String!
	description: String!
	jar: Jar!
	account: Account!
	category: Category
	direction: PaymentTransactionDirection!
}

input CreatePaymentTransaction {
	date: String!
	amount: String!
	counterparty: String!
	description: String!
	jarId: ID!
	accountId: ID!
	categoryId: ID
	direction: PaymentTransactionDirection!
}

type PaymentTransactionCategoryTotal {
	category: Category
	incoming: String!
	outgoing: String!
}

extend type Query {
	getPaymentTransactionCategoryTotals(from: String!, to: String!): [PaymentTransactionCategoryTotal!]!
}

extend type Mutation {
	createPaymentTransaction(req: CreatePaymentTransaction!): PaymentTransaction!
	updatePaymentTransaction(id: ID!, req: CreatePaymentTransaction!): PaymentTransaction!
	deletePaymentTransaction(id: ID!): Boolean!
}
