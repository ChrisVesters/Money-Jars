interface Transaction {
	id: ID!
	date: String!
	amount: Float! # string instead? To not lose precision
	beneficiary: String!
	description: String!
}

enum Direction {
	INCOMING,
	OUTGOING
}

type PaymentTransaction implements Transaction {
	id: ID!
	date: String!
	amount: Float! # string instead? To not lose precision
	beneficiary: String!
	description: String!
	jar: Jar!
	account: Account!
	direction: Direction!
}

extend type Query {
	getTransactions: [Transaction!]!
	getTransaction(id: ID!): Transaction
}

input CreatePaymentTransaction {
	date: String!
	amount: Float! # string instead? To not lose precision
	beneficiary: String!
	description: String!
	jarId: ID!
	accountId: ID!
	direction: Direction!
}

extend type Mutation {
	createPaymentTransaction(req: CreatePaymentTransaction!): PaymentTransaction
	updatePaymentTransaction(id: ID!, req: CreatePaymentTransaction!): PaymentTransaction
	deleteTransaction(id: ID!): Boolean
}