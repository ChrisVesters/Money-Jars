type Account {
	id: ID!
	name: String!
	description: String!
	balance: String!
	inUse: Boolean!
	transactions(query: TransactionSearch = { filter: {} }): TransactionPage!
}

input UpdateAccount {
	name: String!
	description: String!
}

input AccountBalanceQuery {
	accountIds: [ID!]!
}

type AccountBalanceSnapshot {
	date: String!
	balance: String!
}

type AccountBalanceHistory {
	accountId: ID!
	snapshots: [AccountBalanceSnapshot!]!
}

extend type Query {
	getAccounts: [Account!]!
	getAccount(id: ID!): Account!

	queryAccountBalanceHistory(req: AccountBalanceQuery!): [AccountBalanceHistory!]!
}

extend type Mutation {
	createAccount(req: UpdateAccount!): Account!
	updateAccount(id: ID!, req: UpdateAccount!): Account!
	deleteAccount(id: ID!): Boolean!
}
